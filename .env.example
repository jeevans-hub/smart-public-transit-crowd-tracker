MONGODB_URI=mongodb://127.0.0.1:27017/smart-public-transit
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_NAME=Smart Public Transit Crowd Tracker
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BMTC provider: DEMO remains active until a legitimate feed is configured and healthy.
BMTC_REALTIME_ENABLED=false
BMTC_PROVIDER_TYPE=GTFS_RT
BMTC_VEHICLE_POSITIONS_URL=
BMTC_TRIP_UPDATES_URL=
BMTC_ALERTS_URL=
BMTC_GTFS_STATIC_URL=
BMTC_API_KEY=
BMTC_API_KEY_HEADER=x-api-key

# Required provenance fields for real mode. Point to public documentation or terms.
BMTC_FEED_SOURCE_NAME=
BMTC_FEED_TERMS_URL=

BMTC_REFRESH_INTERVAL_MS=30000
BMTC_STALE_AFTER_SECONDS=120
BMTC_REQUEST_TIMEOUT_MS=10000

# Optional Moovit provider. Keep disabled until authorized credentials and the
# account-specific Bengaluru metro/agency IDs have been supplied by Moovit.
# The documented production API base is used when MOOVIT_API_BASE_URL is blank.
MOOVIT_ENABLED=false
MOOVIT_API_BASE_URL=
MOOVIT_API_KEY=
MOOVIT_API_SECRET=
MOOVIT_AUTH_MODE=API_KEY
MOOVIT_HMAC_ENCODING=hex
MOOVIT_METRO_ID=
MOOVIT_AGENCY_ID=
MOOVIT_TRANSIT_TYPE=BUS
MOOVIT_GTFS_STATIC_URL=
MOOVIT_REQUEST_TIMEOUT_MS=10000
MOOVIT_REFRESH_INTERVAL_MS=30000
MOOVIT_STALE_AFTER_SECONDS=120

# Optional SMS alerts. Without these values, Twilio runs in mock mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
